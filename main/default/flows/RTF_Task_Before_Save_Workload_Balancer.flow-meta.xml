    <formulas>
        <name>fxBalanceNote</name>
        <dataType>String</dataType>
        <expression>LEFT(BLANKVALUE({!$Record.Description}, &apos;&apos;) &amp; &apos; [Due date moved +1 day: owner already had &apos; &amp; TEXT({!varSameDayCount}) &amp; &apos; open tasks that day]&apos;, 32000)</expression>
    </formulas>
    <formulas>
        <name>fxClosingSoon</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 7</expression>
    </formulas>
    <formulas>
        <name>fxDueLater</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 5</expression>
    </formulas>
    <formulas>
        <name>fxDueTomorrow</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 1</expression>
    </formulas>
    <formulas>
        <name>fxNextDay</name>
        <dataType>Date</dataType>
        <expression>{!$Record.ActivityDate} + 1</expression>
    </formulas>
    <formulas>
        <name>fxWhatPrefix</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.WhatId}, 3)</expression>
    </formulas>
