    </ends>
    <environments>Default</environments>
    <formulas>
        <name>fxLast24h</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 1</expression>
    </formulas>
    <formulas>
        <name>fxLog_Fault_Subject</name>
        <dataType>String</dataType>
        <expression>LEFT(&apos;[Flow Error] &apos; &amp; &apos;PEF_Flow_Error_Monitor&apos; &amp; &apos; (&apos; &amp; &apos;Critical&apos; &amp; &apos;)&apos;, 255)</expression>
    </formulas>
    <formulas>
        <name>fxMessage</name>
        <dataType>String</dataType>
        <expression>LEFT(&apos;[&apos; &amp; {!varCategory} &amp; &apos;] &apos; &amp; {!$Record.ElementApiName} &amp; &apos;: &apos; &amp; BLANKVALUE({!$Record.ErrorMessage}, &apos;n/a&apos;), 3000)</expression>
    </formulas>
    <formulas>
        <name>fxSub_Log_Flow_Error_Subject</name>
        <dataType>String</dataType>
        <expression>LEFT(&apos;[Flow Error] &apos; &amp; BLANKVALUE({!$Record.FlowApiName}, &apos;&apos;) &amp; &apos; (&apos; &amp; BLANKVALUE({!varSeverity}, &apos;&apos;) &amp; &apos;)&apos;, 255)</expression>
    </formulas>
